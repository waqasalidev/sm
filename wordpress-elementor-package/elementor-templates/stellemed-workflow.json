{
  "version": "0.4",
  "title": "StelleMed - Revenue Cycle Workflows",
  "type": "section",
  "content": [
    {
      "id": "sm_workflow_sec",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "gap": "no"
      },
      "elements": [
        {
          "id": "sm_workflow_col",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "sm_workflow_widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"sm-section\" id=\"how-we-manage\" style=\"padding: 70px 0; background-color: #FFFFFF;\">\n  <div class=\"sm-container\">\n    <div class=\"sm-section-header text-center\">\n      <div class=\"sm-eyebrow\">\n        <span>Proven Workflow Sequences</span>\n      </div>\n      <h2 class=\"sm-title\">\n        How We Manage the <span style=\"color: var(--sm-teal);\">Revenue Cycle</span>\n      </h2>\n      <p class=\"sm-desc\">\n        We operate two distinct, synchronized revenue workflows to guarantee maximum reimbursement from both insurance carriers and patients.\n      </p>\n    </div>\n\n    <!-- Workflow 1 -->\n    <div style=\"margin-bottom: 44px;\">\n      <div class=\"sm-workflow-header-bar\">\n        <div style=\"width:28px; height:28px; border-radius:50%; background:var(--sm-teal); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.85rem;\">+</div>\n        <div>\n          <h3 style=\"font-size:1.15rem; color:var(--sm-navy); margin:0; font-weight:700;\">Insurance / Payer Revenue Cycle</h3>\n          <span style=\"font-size:0.8rem; color:var(--sm-text-secondary);\">7-Step Adjudication &amp; Payer Reimbursement Sequence</span>\n        </div>\n      </div>\n\n      <div class=\"sm-workflow-steps-grid\">\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 01</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Patient Visit</div>\n          <p class=\"sm-workflow-step-desc\">Clinical encounter and documentation captured.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 02</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Eligibility &amp; Auth</div>\n          <p class=\"sm-workflow-step-desc\">Real-time coverage verification &amp; prior auth on file.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 03</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Medical Coding</div>\n          <p class=\"sm-workflow-step-desc\">Certified AAPC/AHIMA CPT, ICD-10 &amp; modifier coding.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 04</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Claim Submission</div>\n          <p class=\"sm-workflow-step-desc\">Scrubbing and EDI 837 dispatch within 24–48h.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 05</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Denials &amp; Appeals</div>\n          <p class=\"sm-workflow-step-desc\">Fast investigation and aggressive clinical appeals.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 06</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Payer Payment</div>\n          <p class=\"sm-workflow-step-desc\">Automated ERA (835) electronic remittance and posting.</p>\n        </div>\n        <div class=\"sm-workflow-step-card\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num\">STEP 07</span>\n            <span style=\"color:var(--sm-teal); font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Practice Paid</div>\n          <p class=\"sm-workflow-step-desc\">Funds deposited cleanly into practice bank accounts.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Workflow 2 -->\n    <div>\n      <div class=\"sm-workflow-header-bar patient\">\n        <div style=\"width:28px; height:28px; border-radius:50%; background:#7C3AED; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.85rem;\">&starf;</div>\n        <div>\n          <h3 style=\"font-size:1.15rem; color:var(--sm-navy); margin:0; font-weight:700;\">Patient Billing Revenue Cycle</h3>\n          <span style=\"font-size:0.8rem; color:var(--sm-text-secondary);\">5-Step Patient Financial Experience &amp; Self-Pay Recovery</span>\n        </div>\n      </div>\n\n      <div class=\"sm-workflow-steps-grid patient\">\n        <div class=\"sm-workflow-step-card patient\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num patient\">STEP 01</span>\n            <span style=\"color:#7C3AED; font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Patient Visit</div>\n          <p class=\"sm-workflow-step-desc\">Point-of-service intake &amp; transparent Good Faith Estimate.</p>\n        </div>\n        <div class=\"sm-workflow-step-card patient\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num patient\">STEP 02</span>\n            <span style=\"color:#7C3AED; font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Patient Statement</div>\n          <p class=\"sm-workflow-step-desc\">Clear digital SMS &amp; paperless statements generated.</p>\n        </div>\n        <div class=\"sm-workflow-step-card patient\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num patient\">STEP 03</span>\n            <span style=\"color:#7C3AED; font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Payment Plan</div>\n          <p class=\"sm-workflow-step-desc\">Customizable recurring payment schedules &amp; balance counseling.</p>\n        </div>\n        <div class=\"sm-workflow-step-card patient\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num patient\">STEP 04</span>\n            <span style=\"color:#7C3AED; font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Patient Payment</div>\n          <p class=\"sm-workflow-step-desc\">Secure 1-click online payment and portal processing.</p>\n        </div>\n        <div class=\"sm-workflow-step-card patient\">\n          <div class=\"sm-workflow-step-header\">\n            <span class=\"sm-workflow-step-num patient\">STEP 05</span>\n            <span style=\"color:#7C3AED; font-size:0.85rem;\">&#10003;</span>\n          </div>\n          <div class=\"sm-workflow-step-title\">Practice Paid</div>\n          <p class=\"sm-workflow-step-desc\">Reconciled balances and maximized self-pay recovery.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"
              }
            }
          ]
        }
      ]
    }
  ]
}