{
  "version": "0.4",
  "title": "StelleMed - 6-Checks QA Gateways",
  "type": "section",
  "content": [
    {
      "id": "sm_checks_sec",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "gap": "no"
      },
      "elements": [
        {
          "id": "sm_checks_col",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "sm_checks_widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"sm-section\" id=\"six-checks\" style=\"padding: 70px 0; background-color: var(--sm-bg-page);\">\n  <div class=\"sm-container\">\n    <div class=\"sm-section-header text-center\">\n      <div class=\"sm-eyebrow\">\n        <span>Pre-Submission Quality Assurance</span>\n      </div>\n      <h2 class=\"sm-title\">\n        Six Checks Before <span style=\"color: var(--sm-teal);\">Every Claim Goes Out</span>\n      </h2>\n      <p class=\"sm-desc\">\n        To protect your revenue and prevent delays, every single claim is evaluated against six vital quality gates before clearinghouse dispatch.\n      </p>\n    </div>\n\n    <div class=\"sm-six-checks-grid\">\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 01</span>\n          <h3 class=\"sm-check-title\">Patient Details Complete &amp; Correct</h3>\n          <p class=\"sm-check-desc\">Demographic fields, subscriber IDs, relationship codes, and group numbers verified 100% error-free.</p>\n        </div>\n      </div>\n\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 02</span>\n          <h3 class=\"sm-check-title\">Coverage Confirmed for Date of Service</h3>\n          <p class=\"sm-check-desc\">Active policy status, effective date windows, co-pays, and deductibles verified before batch generation.</p>\n        </div>\n      </div>\n\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 03</span>\n          <h3 class=\"sm-check-title\">Prior Authorization on File Where Required</h3>\n          <p class=\"sm-check-desc\">Auth reference numbers logged and attached directly to billing lines for required clinical encounters.</p>\n        </div>\n      </div>\n\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 04</span>\n          <h3 class=\"sm-check-title\">Codes Match the Documentation</h3>\n          <p class=\"sm-check-desc\">CPT, ICD-10-CM, and HCPCS modifiers aligned accurately with clinical notes to justify medical necessity.</p>\n        </div>\n      </div>\n\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 05</span>\n          <h3 class=\"sm-check-title\">Claim Scrubber Edits Passed</h3>\n          <p class=\"sm-check-desc\">Evaluated through StelleCloud™ rules engine to catch NCCI bundle conflicts and modifier errors.</p>\n        </div>\n      </div>\n\n      <div class=\"sm-check-card\">\n        <div class=\"sm-check-icon\">&#10003;</div>\n        <div>\n          <span class=\"sm-check-badge\">CHECK 06</span>\n          <h3 class=\"sm-check-title\">Payer-Specific Rules Applied</h3>\n          <p class=\"sm-check-desc\">Carrier-specific billing guidelines applied so claims meet local clearinghouse requirements first pass.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"
              }
            }
          ]
        }
      ]
    }
  ]
}