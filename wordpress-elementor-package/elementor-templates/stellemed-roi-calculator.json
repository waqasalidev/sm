{
  "version": "0.4",
  "title": "StelleMed - Practice ROI Calculator",
  "type": "section",
  "content": [
    {
      "id": "sm_roi_sec",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "gap": "no"
      },
      "elements": [
        {
          "id": "sm_roi_col",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "sm_roi_widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n/**\n * StelleMed Elementor Addon - Core Styling\n * Ultra-lightweight, zero dependency CSS for StelleMed widgets & templates\n */\n\n:root {\n  --sm-navy: #102C40;\n  --sm-navy-dark: #0A1B28;\n  --sm-navy-light: #163C57;\n  --sm-teal: #179A9E;\n  --sm-teal-hover: #1EB2B7;\n  --sm-teal-light: #EAF8F8;\n  --sm-teal-accent: #38D4D8;\n  --sm-white: #FFFFFF;\n  --sm-bg-page: #F8FBFC;\n  --sm-text-primary: #0F202E;\n  --sm-text-secondary: #475D70;\n  --sm-text-muted: #738A9E;\n  --sm-text-light: #F0F6FA;\n  --sm-border: #E2ECF2;\n  --sm-radius-sm: 6px;\n  --sm-radius-md: 10px;\n  --sm-radius-lg: 16px;\n  --sm-radius-xl: 24px;\n}\n\n/* Base Utility Classes */\n.sm-container {\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 20px;\n  box-sizing: border-box;\n}\n\n.sm-section-header {\n  margin-bottom: 44px;\n}\n.sm-section-header.text-center {\n  text-align: center;\n}\n\n.sm-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 0.8125rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--sm-teal);\n  background: var(--sm-teal-light);\n  padding: 6px 14px;\n  border-radius: 9999px;\n  margin-bottom: 14px;\n}\n.sm-eyebrow.dark-theme {\n  background: rgba(56, 212, 216, 0.15);\n  color: var(--sm-teal-accent);\n}\n\n.sm-title {\n  font-size: clamp(1.8rem, 3.2vw, 2.5rem);\n  font-weight: 800;\n  color: var(--sm-navy);\n  line-height: 1.25;\n  margin: 0 0 14px 0;\n}\n.sm-title.dark-theme {\n  color: var(--sm-white);\n}\n\n.sm-desc {\n  font-size: 1.05rem;\n  color: var(--sm-text-secondary);\n  line-height: 1.6;\n  max-width: 680px;\n  margin: 0 auto;\n}\n.sm-desc.dark-theme {\n  color: #A3B9CC;\n}\n\n.sm-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  font-weight: 700;\n  font-size: 0.9375rem;\n  padding: 13px 26px;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n  text-decoration: none;\n  border: none;\n}\n.sm-btn-primary {\n  background-color: var(--sm-teal);\n  color: #FFFFFF !important;\n  box-shadow: 0 4px 14px rgba(23, 154, 158, 0.3);\n}\n.sm-btn-primary:hover {\n  background-color: var(--sm-teal-hover);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 20px rgba(23, 154, 158, 0.4);\n}\n\n/* ==========================================================================\n   1. ROI CALCULATOR WIDGET\n   ========================================================================== */\n.sm-roi-section {\n  background: linear-gradient(135deg, #102C40 0%, #0D2333 100%);\n  color: var(--sm-white);\n  padding: 80px 0;\n  border-radius: var(--sm-radius-xl);\n  margin: 20px 0;\n}\n\n.sm-roi-card {\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  border-radius: var(--sm-radius-xl);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  padding: 40px;\n  box-sizing: border-box;\n}\n\n.sm-roi-grid {\n  display: grid;\n  grid-template-columns: 1.15fr 0.85fr;\n  gap: 40px;\n  align-items: center;\n}\n\n.sm-roi-controls {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.sm-roi-group {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.sm-roi-label-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.sm-roi-label {\n  font-size: 0.9375rem;\n  font-weight: 600;\n  color: var(--sm-text-light);\n}\n\n.sm-roi-val {\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: var(--sm-teal-accent);\n}\n\n.sm-roi-slider {\n  width: 100%;\n  height: 8px;\n  border-radius: 4px;\n  background: rgba(255, 255, 255, 0.2);\n  outline: none;\n  -webkit-appearance: none;\n  cursor: pointer;\n}\n.sm-roi-slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  background: var(--sm-teal);\n  box-shadow: 0 0 10px rgba(23, 154, 158, 0.7);\n  cursor: pointer;\n  border: 2px solid #FFFFFF;\n}\n\n.sm-roi-select {\n  width: 100%;\n  padding: 12px 16px;\n  border-radius: var(--sm-radius-md);\n  background-color: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  color: #FFFFFF;\n  font-size: 0.9375rem;\n  outline: none;\n}\n.sm-roi-select option {\n  background-color: var(--sm-navy);\n  color: #FFFFFF;\n}\n\n.sm-roi-results {\n  background: linear-gradient(135deg, rgba(23, 154, 158, 0.2) 0%, rgba(16, 44, 64, 0.6) 100%);\n  border: 1.5px solid rgba(56, 212, 216, 0.4);\n  border-radius: var(--sm-radius-lg);\n  padding: 32px 26px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.3);\n}\n\n.sm-roi-highlight-title {\n  font-size: 0.8125rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #A3B9CC;\n  font-weight: 700;\n}\n\n.sm-roi-amount {\n  font-size: clamp(2rem, 3.5vw, 2.8rem);\n  font-weight: 800;\n  color: var(--sm-teal-accent);\n  line-height: 1.1;\n}\n\n.sm-roi-metrics-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  padding: 14px 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.12);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n}\n\n.sm-roi-metric-label {\n  font-size: 0.75rem;\n  color: #A3B9CC;\n  text-transform: uppercase;\n}\n\n.sm-roi-metric-num {\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: #FFFFFF;\n  margin-top: 4px;\n}\n\n/* ==========================================================================\n   2. SIX CHECKS QUALITY ASSURANCE WIDGET\n   ========================================================================== */\n.sm-six-checks-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n  gap: 24px;\n}\n\n.sm-check-card {\n  padding: 24px;\n  border-radius: var(--sm-radius-md);\n  background-color: #FFFFFF;\n  border: 1px solid var(--sm-border);\n  display: flex;\n  gap: 16px;\n  align-items: flex-start;\n  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.04);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n.sm-check-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 24px rgba(16, 44, 64, 0.08);\n  border-color: rgba(23, 154, 158, 0.3);\n}\n\n.sm-check-icon {\n  width: 44px;\n  height: 44px;\n  border-radius: var(--sm-radius-sm);\n  background: var(--sm-teal-light);\n  color: var(--sm-teal);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  font-size: 1.25rem;\n}\n\n.sm-check-badge {\n  font-size: 0.75rem;\n  font-weight: 800;\n  color: var(--sm-teal);\n  letter-spacing: 0.5px;\n  margin-bottom: 4px;\n  display: inline-block;\n}\n\n.sm-check-title {\n  font-size: 1.05rem;\n  color: var(--sm-navy);\n  font-weight: 700;\n  margin: 0 0 6px 0;\n}\n\n.sm-check-desc {\n  font-size: 0.875rem;\n  color: var(--sm-text-secondary);\n  line-height: 1.5;\n  margin: 0;\n}\n\n/* ==========================================================================\n   3. REVENUE LEAKS WIDGET\n   ========================================================================== */\n.sm-leaks-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 20px;\n  margin-bottom: 36px;\n}\n\n.sm-leak-card {\n  padding: 24px 20px;\n  border-radius: var(--sm-radius-md);\n  border: 1px solid var(--sm-border);\n  border-top: 3px solid var(--sm-teal);\n  background-color: #FFFFFF;\n  box-shadow: 0 2px 6px rgba(16, 44, 64, 0.04);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n.sm-leak-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 20px rgba(16, 44, 64, 0.08);\n}\n\n.sm-leak-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 12px;\n}\n\n.sm-leak-badge {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: #FEE2E2;\n  color: #DC2626;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.8rem;\n  font-weight: 800;\n  flex-shrink: 0;\n}\n\n.sm-leak-title {\n  font-size: 1.1rem;\n  color: var(--sm-navy);\n  margin: 0;\n  font-weight: 700;\n}\n\n.sm-leak-desc {\n  font-size: 0.875rem;\n  color: var(--sm-text-secondary);\n  line-height: 1.55;\n  margin: 0;\n}\n\n.sm-leaks-banner {\n  background: linear-gradient(135deg, var(--sm-navy) 0%, #103456 100%);\n  color: #FFFFFF;\n  border-radius: var(--sm-radius-lg);\n  padding: 28px 32px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  box-shadow: 0 8px 24px rgba(16, 44, 64, 0.08);\n}\n\n/* ==========================================================================\n   4. REVENUE CYCLE WORKFLOW WIDGET\n   ========================================================================== */\n.sm-workflow-header-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 20px;\n  padding: 12px 18px;\n  background: var(--sm-bg-page);\n  border-radius: var(--sm-radius-md);\n  border-left: 4px solid var(--sm-teal);\n}\n.sm-workflow-header-bar.patient {\n  border-left-color: #7C3AED;\n}\n\n.sm-workflow-steps-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 12px;\n}\n.sm-workflow-steps-grid.patient {\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n}\n\n.sm-workflow-step-card {\n  background: #F8FBFC;\n  border: 1px solid var(--sm-border);\n  border-radius: var(--sm-radius-md);\n  padding: 16px 12px;\n  display: flex;\n  flex-direction: column;\n  transition: all 0.2s ease;\n}\n.sm-workflow-step-card.patient {\n  background: #FDFBFF;\n  border-color: #E9D5FF;\n}\n\n.sm-workflow-step-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n\n.sm-workflow-step-num {\n  font-size: 0.75rem;\n  font-weight: 800;\n  color: var(--sm-teal);\n}\n.sm-workflow-step-num.patient {\n  color: #7C3AED;\n}\n\n.sm-workflow-step-title {\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: var(--sm-navy);\n  margin-bottom: 6px;\n}\n\n.sm-workflow-step-desc {\n  font-size: 0.75rem;\n  color: var(--sm-text-secondary);\n  line-height: 1.4;\n  margin: 0;\n}\n\n/* ==========================================================================\n   5. WHY CHOOSE US WIDGET\n   ========================================================================== */\n.sm-why-section {\n  background: linear-gradient(135deg, #0A1B28 0%, #102C40 100%);\n  padding: 80px 0;\n  border-radius: var(--sm-radius-xl);\n  color: #FFFFFF;\n}\n\n.sm-why-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 24px;\n  margin-top: 40px;\n}\n\n.sm-why-card {\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: var(--sm-radius-lg);\n  padding: 32px 24px;\n  display: flex;\n  flex-direction: column;\n  transition: transform 0.25s ease, border-color 0.25s ease;\n}\n.sm-why-card:hover {\n  transform: translateY(-6px);\n  border-color: rgba(56, 212, 216, 0.4);\n}\n\n.sm-why-icon {\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: rgba(23, 154, 158, 0.2);\n  color: var(--sm-teal-accent);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.5rem;\n  margin-bottom: 18px;\n}\n\n.sm-why-card-title {\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: #FFFFFF;\n  margin: 0 0 10px 0;\n}\n\n.sm-why-card-desc {\n  font-size: 0.9375rem;\n  color: #A3B9CC;\n  line-height: 1.6;\n  margin: 0;\n}\n\n/* ==========================================================================\n   6. FAQ ACCORDION WIDGET\n   ========================================================================== */\n.sm-faq-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  max-width: 860px;\n  margin: 0 auto;\n}\n\n.sm-faq-item {\n  background: #FFFFFF;\n  border: 1px solid var(--sm-border);\n  border-radius: var(--sm-radius-md);\n  overflow: hidden;\n  transition: all 0.2s ease;\n}\n.sm-faq-item.is-open {\n  border-color: rgba(23, 154, 158, 0.4);\n  box-shadow: 0 4px 14px rgba(16, 44, 64, 0.06);\n}\n\n.sm-faq-btn {\n  width: 100%;\n  padding: 20px 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: none;\n  border: none;\n  cursor: pointer;\n  text-align: left;\n  font-size: 1.05rem;\n  font-weight: 700;\n  color: var(--sm-navy);\n}\n\n.sm-faq-icon {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--sm-teal-light);\n  color: var(--sm-teal);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.1rem;\n  transition: transform 0.25s ease;\n  flex-shrink: 0;\n}\n.sm-faq-item.is-open .sm-faq-icon {\n  transform: rotate(180deg);\n}\n\n.sm-faq-content {\n  padding: 0 24px 20px 24px;\n  font-size: 0.9375rem;\n  color: var(--sm-text-secondary);\n  line-height: 1.6;\n  display: none;\n}\n.sm-faq-item.is-open .sm-faq-content {\n  display: block;\n}\n\n/* Responsive Media Queries */\n@media (max-width: 900px) {\n  .sm-roi-grid {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 600px) {\n  .sm-roi-card {\n    padding: 20px 16px;\n  }\n  .sm-leaks-banner {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n\n</style>\n\n<div class=\"sm-roi-section\" id=\"roi-calculator\">\n  <div class=\"sm-container\">\n    <div class=\"sm-section-header text-center\">\n      <div class=\"sm-eyebrow dark-theme\">\n        <span>Practice Revenue Recovery Estimator</span>\n      </div>\n      <h2 class=\"sm-title dark-theme\">\n        Calculate Your Practice’s <span style=\"color: #38D4D8;\">Lost Revenue Recovery</span>\n      </h2>\n      <p class=\"sm-desc dark-theme\">\n        Average US practices lose 15% to 25% of legitimate billings to unresolved claim denials, coding inaccuracies, and delayed payer follow-ups. See how much StelleMed can recapture.\n      </p>\n    </div>\n\n    <div class=\"sm-roi-card\">\n      <div class=\"sm-roi-grid\">\n        <!-- Left: Sliders -->\n        <div class=\"sm-roi-controls\">\n          <div class=\"sm-roi-group\">\n            <div class=\"sm-roi-label-row\">\n              <span class=\"sm-roi-label\">Current Monthly Practice Billings</span>\n              <span class=\"sm-roi-val sm-roi-billing-display\">$120,000 / mo</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"30000\"\n              max=\"1000000\"\n              step=\"10000\"\n              value=\"120000\"\n              class=\"sm-roi-slider sm-roi-billing-slider\"\n              aria-label=\"Monthly Billing Amount\"\n            />\n            <div style=\"display:flex; justify-content:space-between; font-size:0.75rem; color:#A3B9CC;\">\n              <span>$30k/mo</span>\n              <span>$500k/mo</span>\n              <span>$1M+/mo</span>\n            </div>\n          </div>\n\n          <div class=\"sm-roi-group\">\n            <label class=\"sm-roi-label\">Primary Medical Specialty</label>\n            <select class=\"sm-roi-select sm-roi-specialty-select\">\n              <option value=\"internal-medicine\">Internal Medicine / Primary Care</option>\n              <option value=\"cardiology\">Cardiology</option>\n              <option value=\"orthopedics\">Orthopedics &amp; Sports Medicine</option>\n              <option value=\"pediatrics\">Pediatrics</option>\n              <option value=\"mental-health\">Behavioral &amp; Mental Health</option>\n              <option value=\"surgery\">General Surgery / ASC</option>\n              <option value=\"dermatology\">Dermatology</option>\n              <option value=\"multi-specialty\">Multi-Specialty Clinic</option>\n            </select>\n          </div>\n\n          <div class=\"sm-roi-group\">\n            <div class=\"sm-roi-label-row\">\n              <span class=\"sm-roi-label\">Number of Billing Providers</span>\n              <span class=\"sm-roi-val sm-roi-provider-display\">3 Providers</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"1\"\n              max=\"25\"\n              step=\"1\"\n              value=\"3\"\n              class=\"sm-roi-slider sm-roi-provider-slider\"\n              aria-label=\"Billing Providers\"\n            />\n          </div>\n        </div>\n\n        <!-- Right: Results -->\n        <div class=\"sm-roi-results\">\n          <div>\n            <span class=\"sm-roi-highlight-title\">Estimated Annual Revenue Recaptured</span>\n            <div class=\"sm-roi-amount\">$259,200</div>\n            <div style=\"font-size:0.8125rem; color:#EAF8F8; margin-top:4px;\">\n              *Based on average 18% - 22% denial recovery &amp; underpayment audits\n            </div>\n          </div>\n\n          <div class=\"sm-roi-metrics-row\">\n            <div>\n              <span class=\"sm-roi-metric-label\">A/R Days Reduction</span>\n              <div class=\"sm-roi-metric-num sm-roi-ar-days\">52d &rarr; <span style=\"color:#38D4D8;\">26 days</span></div>\n            </div>\n            <div>\n              <span class=\"sm-roi-metric-label\">Target Clean Claims</span>\n              <div class=\"sm-roi-metric-num\" style=\"color:#38D4D8;\">98.5%</div>\n            </div>\n          </div>\n\n          <div style=\"display:flex; flex-direction:column; gap:8px; font-size:0.8125rem; color:#D2E3EF;\">\n            <div>&#10003; Elimination of payer denial backlogs</div>\n            <div>&#10003; Real-time EHR clearinghouse claim validation</div>\n          </div>\n\n          <a href=\"#contact\" class=\"sm-btn sm-btn-primary\" style=\"width:100%; box-sizing:border-box;\">\n            <span>Claim Your Detailed Practice Audit</span>\n            <span>&rarr;</span>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n/**\n * StelleMed Elementor Addon - Core JavaScript\n * Handles real-time interactive calculations and UI toggles\n */\n\n(function () {\n  'use strict';\n\n  function formatCurrency(num) {\n    return '$' + Math.round(num).toLocaleString('en-US');\n  }\n\n  // 1. Initialize ROI Calculator\n  function initRoiCalculator(scope) {\n    var container = scope ? scope.querySelector('.sm-roi-card') : document.querySelector('.sm-roi-card');\n    if (!container) return;\n\n    var billingSlider = container.querySelector('.sm-roi-billing-slider');\n    var billingDisplay = container.querySelector('.sm-roi-billing-display');\n    var specialtySelect = container.querySelector('.sm-roi-specialty-select');\n    var providerSlider = container.querySelector('.sm-roi-provider-slider');\n    var providerDisplay = container.querySelector('.sm-roi-provider-display');\n    var recoveredAmount = container.querySelector('.sm-roi-amount');\n    var arDaysDisplay = container.querySelector('.sm-roi-ar-days');\n\n    function updateCalculations() {\n      if (!billingSlider || !recoveredAmount) return;\n\n      var monthlyBilling = parseFloat(billingSlider.value) || 120000;\n      var specialty = specialtySelect ? specialtySelect.value : 'internal-medicine';\n      var providerCount = providerSlider ? parseInt(providerSlider.value, 10) : 3;\n\n      // Update slider display labels\n      if (billingDisplay) {\n        billingDisplay.textContent = formatCurrency(monthlyBilling) + ' / mo';\n      }\n      if (providerDisplay) {\n        providerDisplay.textContent = providerCount + (providerCount === 1 ? ' Provider' : ' Providers');\n      }\n\n      // Calculation logic\n      var recoveryRate = (specialty === 'orthopedics' || specialty === 'surgery') ? 0.22 : 0.18;\n      var annualRecaptured = monthlyBilling * 12 * recoveryRate;\n      var currentArDays = 48 + Math.round(providerCount * 1.5);\n\n      recoveredAmount.textContent = formatCurrency(annualRecaptured);\n\n      if (arDaysDisplay) {\n        arDaysDisplay.innerHTML = currentArDays + 'd &rarr; <span style=\"color:#38D4D8;\">26 days</span>';\n      }\n    }\n\n    if (billingSlider) billingSlider.addEventListener('input', updateCalculations);\n    if (specialtySelect) specialtySelect.addEventListener('change', updateCalculations);\n    if (providerSlider) providerSlider.addEventListener('input', updateCalculations);\n\n    // Initial calculation run\n    updateCalculations();\n  }\n\n  // 2. Initialize FAQ Accordion\n  function initFaqAccordion(scope) {\n    var root = scope || document;\n    var faqItems = root.querySelectorAll('.sm-faq-item');\n    if (!faqItems.length) return;\n\n    faqItems.forEach(function (item) {\n      var btn = item.querySelector('.sm-faq-btn');\n      if (!btn) return;\n\n      btn.addEventListener('click', function () {\n        var isOpen = item.classList.contains('is-open');\n        // Close siblings if desired or simply toggle\n        item.classList.toggle('is-open', !isOpen);\n      });\n    });\n  }\n\n  // DOM Ready initialization\n  document.addEventListener('DOMContentLoaded', function () {\n    initRoiCalculator(document);\n    initFaqAccordion(document);\n  });\n\n  // Elementor Frontend hooks (for live editor compatibility)\n  if (window.elementorFrontend && window.elementorFrontend.hooks) {\n    window.addEventListener('elementor/frontend/init', function () {\n      window.elementorFrontend.hooks.addAction('frontend/element_ready/sm_roi_calculator.default', function ($scope) {\n        initRoiCalculator($scope[0]);\n      });\n      window.elementorFrontend.hooks.addAction('frontend/element_ready/sm_faq.default', function ($scope) {\n        initFaqAccordion($scope[0]);\n      });\n    });\n  }\n})();\n\n</script>"
              }
            }
          ]
        }
      ]
    }
  ]
}