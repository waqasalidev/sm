low":"hidden"},"elements":[{"id":"pdrya98","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://raw.githubusercontent.com/waqasalidev/sm/main/src/assets/stellemed-physician.png"},"image_size":"thumbnail"}}]},{"id":"r9lqfs6","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_align_items":"flex-start","flex_gap":{"unit":"px","size":2,"column":"2","row":"2"}},"elements":[{"id":"r6btsib","elType":"widget","widgetType":"heading","settings":{"title":"<span id=\"testi-name\">Maria Lopez</span>","header_size":"h4","title_color":"#0C2340","typography_typography":"custom","typography_font_family":"Plus Jakarta Sans","typography_font_size":{"unit":"px","size":15},"typography_font_weight":"700"}},{"id":"zdbygmo","elType":"widget","widgetType":"heading","settings":{"title":"<span id=\"testi-title\">Practice Administrator • Summit Regional Medical Group</span>","header_size":"span","title_color":"#179A9E","typography_typography":"custom","typography_font_family":"Plus Jakarta Sans","typography_font_size":{"unit":"px","size":12.5},"typography_font_weight":"600"}},{"id":"d66wtjm","elType":"widget","widgetType":"heading","settings":{"title":"<span id=\"testi-specialty\">Multi-Specialty Care</span>","header_size":"span","title_color":"#64748B","typography_typography":"custom","typography_font_family":"Plus Jakarta Sans","typography_font_size":{"unit":"px","size":12},"typography_font_weight":"400"}}]}]}]},{"id":"04z200t","elType":"widget","widgetType":"html","settings":{"html":"<div style=\"display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:16px;\">\n              <button onclick=\"prevTestimonial()\" aria-label=\"Previous\" style=\"width:36px;height:36px;border-radius:50%;border:1px solid #CBD5E1;background:#FFFFFF;color:#0C2340;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:14px;transition:all 0.2s;\">&#10094;</button>\n              <div id=\"testi-dots\" style=\"display:flex;align-items:center;gap:6px;\">\n                <span style=\"width:20px;height:7px;border-radius:4px;background:#179A9E;cursor:pointer;\" onclick=\"setTestimonial(0)\"></span>\n                <span style=\"width:7px;height:7px;border-radius:50%;background:#CBD5E1;cursor:pointer;\" onclick=\"setTestimonial(1)\"></span>\n                <span style=\"width:7px;height:7px;border-radius:50%;background:#CBD5E1;cursor:pointer;\" onclick=\"setTestimonial(2)\"></span>\n                <span style=\"width:7px;height:7px;border-radius:50%;background:#CBD5E1;cursor:pointer;\" onclick=\"setTestimonial(3)\"></span>\n              </div>\n              <button onclick=\"nextTestimonial()\" aria-label=\"Next\" style=\"width:36px;height:36px;border-radius:50%;border:1px solid #CBD5E1;background:#FFFFFF;color:#0C2340;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:14px;transition:all 0.2s;\">&#10095;</button>\n            </div>\n            <script>\n              const testiData = [{\"quote\":\"Having one dedicated account manager instead of an impersonal support queue changed everything for our practice. They actually know our providers, understand our specialty, and turn claims around in days.\",\"metric\":\"REDUCED A/R DAYS FROM 54 TO 26 DAYS\",\"name\":\"Maria Lopez\",\"title\":\"Practice Administrator • Summit Regional Medical Group\",\"specialty\":\"Multi-Specialty Care\",\"avatar\":\"https://raw.githubusercontent.com/waqasalidev/sm/main/src/assets/stellemed-physician.png\"},{\"quote\":\"Patient billing used to consume hours of our front-desk staff's time every single day. With StelleMed and StelleCloud handling patient statements and digital collections, our staff can focus 100% on patients in the waiting room.\",\"metric\":\"CLEAN CLAIM RATE STEADY AT 98.6%\",\"name\":\"Dr. Sarah Bennett, MD\",\"title\":\"Medical Director • Coastal Orthopedic & Spine Center\",\"specialty\":\"Orthopedic Surgery\",\"avatar\":\"https://raw.githubusercontent.com/waqasalidev/sm/main/src/assets/stellemed-physician.png\"},{\"quote\":\"We used to spend hours every week on hold with commercial payers fighting over trivial modifier rejections. Our StelleMed account specialist tackles appeals aggressively and recovers funds we had written off.\",\"metric\":\"99% PAYER CONTRACT COMPLIANCE\",\"name\":\"Lisa Alvarez\",\"title\":\"Billing Coordinator • Harborview Cardiology Associates\",\"specialty\":\"Cardiology\",\"avatar\":\"https://raw.githubusercontent.com/waqasalidev/sm/main/src/assets/stellemed-physician.png\"},{\"quote\":\"The monthly reports finally gave our executive team a transparent, clear picture of where our revenue was going — and where denials were getting stuck. StelleMed cleaned up our aging A/R in under 60 days.\",\"metric\":\"+22% INCREASE IN MONTHLY COLLECTIONS\",\"name\":\"David Chen, MHA\",\"title\":\"Chief Operating Officer • Apex Family Medicine Network\",\"specialty\":\"Primary Care & Pediatrics\",\"avatar\":\"https://raw.githubusercontent.com/waqasalidev/sm/main/src/assets/stellemed-physician.png\"}];\n              let currentTestiIdx = 0;\n              function updateTestiUI() {\n                const item = testiData[currentTestiIdx];\n                document.getElementById('testi-metric').innerText = item.metric;\n                document.getElementById('testi-quote').innerText = '“' + item.quote + '”';\n                document.getElementById('testi-name').innerText = item.name;\n                document.getElementById('testi-title').innerText = item.title;\n                document.getElementById('testi-specialty').innerText = item.specialty;\n                const dots = document.getElementById('testi-dots').children;\n                for (let i = 0; i < dots.length; i++) {\n                  if (i === currentTestiIdx) {\n                    dots[i].style.width = '20px';\n                    dots[i].style.borderRadius = '4px';\n                    dots[i].style.background = '#179A9E';\n                  } else {\n                    dots[i].style.width = '7px';\n                    dots[i].style.borderRadius = '50%';\n                    dots[i].style.background = '#CBD5E1';\n                  }\n                }\n              }\n              function prevTestimonial() {\n                currentTestiIdx = (currentTestiIdx - 1 + testiData.length) % testiData.length;\n                updateTestiUI();\n              }\n              function nextTestimonial() {\n                currentTestiIdx = (currentTestiIdx + 1) % testiData.length;\n                updateTestiUI();\n              }\n              function setTestimonial(idx) {\n                currentTestiIdx = idx;\n                updateTestiUI();\n              }\n            </script>"}},{"id":"qo07n64","elType":"widget","widgetType":"heading","settings":{"title":"<i class=\"fas fa-info-circle\"></i> Illustrative client case scenarios representing common healthcare provider workflows and results.","header_size":"span","align":"center","title_color":"#94A3B8","typography_typography":"custom","typography_font_family":"Plus Jakarta Sans","typography_font_size":{"unit":"px","size":11.5},"typography_font_weight":"400"}}]}]}