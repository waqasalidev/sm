                  "settings": {
                    "title": "<nav>\n                  <style>\n                    .sm-nav-list {\n                      display: inline-flex;\n                      align-items: center;\n                      gap: 10px;\n                      margin: 0;\n                      padding: 0;\n                      list-style: none;\n                      font-family: 'Plus Jakarta Sans', sans-serif;\n                    }\n                    .sm-item {\n                      position: relative;\n                      padding: 6px 0;\n                    }\n                    .sm-link {\n                      display: inline-flex;\n                      align-items: center;\n                      gap: 4px;\n                      padding: 8px 14px;\n                      color: #0C2340;\n                      font-size: 14.5px;\n                      font-weight: 700;\n                      text-decoration: none;\n                      border-radius: 8px;\n                      transition: all 0.2s ease;\n                    }\n                    .sm-link:hover {\n                      color: #179A9E;\n                      background-color: rgba(23, 154, 158, 0.06);\n                    }\n                    .sm-link.active {\n                      background-color: #EAF8F8;\n                      color: #179A9E;\n                    }\n                    .sm-menu {\n                      position: absolute;\n                      top: 100%;\n                      left: 0;\n                      min-width: 270px;\n                      background: #FFFFFF;\n                      border: 1px solid #E2E8F0;\n                      border-radius: 12px;\n                      box-shadow: 0 12px 32px rgba(12, 35, 64, 0.12);\n                      padding: 8px;\n                      margin: 0;\n                      list-style: none;\n                      opacity: 0;\n                      visibility: hidden;\n                      transform: translateY(8px);\n                      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n                      z-index: 99999;\n                    }\n                    .sm-item:hover .sm-menu,\n                    .sm-item:focus-within .sm-menu {\n                      opacity: 1;\n                      visibility: visible;\n                      transform: translateY(0);\n                    }\n                    .sm-menu-link {\n                      display: flex;\n                      align-items: center;\n                      gap: 10px;\n                      padding: 10px 14px;\n                      color: #0C2340;\n                      font-size: 13.5px;\n                      font-weight: 600;\n                      text-decoration: none;\n                      border-radius: 8px;\n                      transition: all 0.2s ease;\n                    }\n                    .sm-menu-link i {\n                      color: #179A9E;\n                      font-size: 13.5px;\n                      width: 18px;\n                      text-align: center;\n                    }\n                    .sm-menu-link:hover {\n                      background-color: #F1FBFB;\n                      color: #179A9E;\n                      padding-left: 17px;\n                    }\n                  </style>\n\n                  <ul class=\"sm-nav-list\">\n                    <!-- 1. Home -->\n                    <li class=\"sm-item\">\n                      <a href=\"/\" class=\"sm-link active\">Home</a>\n                    </li>\n\n                    <!-- 2. Services (with 3 Sub-Services Dropdown) -->\n                    <li class=\"sm-item\">\n                      <a href=\"/services\" class=\"sm-link\">\n                        <span>Services</span>\n                        <i class=\"fas fa-chevron-down\" style=\"font-size:10px;margin-left:2px;\"></i>\n                      </a>\n                      <ul class=\"sm-menu\">\n                        <li>\n                          <a href=\"/services/insurance-payer\" class=\"sm-menu-link\">\n                            <i class=\"fas fa-file-invoice-dollar\"></i>\n                            <span>Insurance &amp; Payer Services</span>\n                          </a>\n                        </li>\n                        <li>\n                          <a href=\"/services/patient-practice\" class=\"sm-menu-link\">\n                            <i class=\"fas fa-user-shield\"></i>\n                            <span>Patient &amp; Practice Services</span>\n                          </a>\n                        </li>\n                        <li>\n                          <a href=\"/services/technology-support\" class=\"sm-menu-link\">\n                            <i class=\"fas fa-server\"></i>\n                            <span>Technology &amp; Support</span>\n                          </a>\n                        </li>\n                      </ul>\n                    </li>\n\n                    <!-- 3. About Us -->\n                    <li class=\"sm-item\">\n                      <a href=\"/about\" class=\"sm-link\">About Us</a>\n                    </li>\n\n                    <!-- 4. Resources (with Calculator, How It Works, FAQ Dropdown) -->\n                    <li class=\"sm-item\">\n                      <a href=\"/resources\" class=\"sm-link\">\n                        <span>Resources</span>\n                        <i class=\"fas fa-chevron-down\" style=\"font-size:10px;margin-left:2px;\"></i>\n                      </a>\n                      <ul class=\"sm-menu\">\n                        <li>\n                          <a href=\"/#roi-calculator\" class=\"sm-menu-link\">\n                            <i class=\"fas fa-calculator\"></i>\n                            <span>Revenue Recovery Calculator</span>\n                          </a>\n                        </li>\n                        <li>\n                          <a href=\"/#how-it-works\" class=\"sm-menu-link\">\n  