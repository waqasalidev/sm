            {
              "id": "qluto3a",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<style>\n  /* 1. Search Bar Styling */\n  .sm-spec-search-container {\n    max-width: 440px;\n    margin: 20px auto 34px;\n    position: relative;\n    box-sizing: border-box;\n  }\n  .sm-spec-search-icon {\n    position: absolute;\n    left: 15px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: #94A3B8;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n  }\n  .sm-spec-search-input {\n    width: 100%;\n    box-sizing: border-box;\n    padding: 12px 16px 12px 42px;\n    border-radius: 10px;\n    border: 1.5px solid #E2ECF2;\n    background-color: #FFFFFF;\n    font-family: 'Inter', sans-serif;\n    font-size: 14.5px;\n    color: #102C40;\n    outline: none;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n    box-shadow: 0 2px 6px rgba(16, 44, 64, 0.04);\n  }\n  .sm-spec-search-input:focus {\n    border-color: #179A9E;\n    box-shadow: 0 0 0 3px rgba(23, 154, 158, 0.15);\n  }\n\n  /* 2. 28 Specialties Grid (5 columns Desktop, 3 Tablet, 1 Mobile) */\n  .sm-spec-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 14px;\n    margin-bottom: 36px;\n  }\n  @media (max-width: 1024px) {\n    .sm-spec-grid {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 12px;\n    }\n  }\n  @media (max-width: 640px) {\n    .sm-spec-grid {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n  }\n\n  /* 3. Specialty Cards - STRICTLY ZERO HOVER LIFT ANIMATION */\n  .sm-spec-card {\n    background-color: #F8FBFC;\n    border: 1px solid #E2ECF2;\n    border-radius: 10px;\n    padding: 15px 14px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    cursor: pointer;\n    box-sizing: border-box;\n    min-height: 72px;\n    user-select: none;\n    /* USER EXPLICIT REQUIREMENT: is mein tumne hover effect nhi lagana */\n    transition: border-color 0.15s ease !important;\n    transform: none !important;\n  }\n  .sm-spec-card:hover {\n    transform: none !important;\n    border-color: #179A9E !important;\n  }\n\n  .sm-spec-cat {\n    font-size: 11px;\n    font-weight: 800;\n    color: #179A9E;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 4px;\n    line-height: 1.2;\n  }\n  .sm-spec-name {\n    font-size: 15px;\n    font-weight: 700;\n    color: #102C40;\n    line-height: 1.3;\n  }\n\n  /* No results alert */\n  .sm-spec-empty {\n    display: none;\n    text-align: center;\n    padding: 30px;\n    background: #F8FBFC;\n    border: 1px dashed #CBD5E1;\n    border-radius: 10px;\n    color: #64748B;\n    font-size: 15px;\n    margin-bottom: 30px;\n  }\n\n  /* 4. Bottom Text & Action Button */\n  .sm-bottom-cta-wrap {\n    text-align: center;\n    margin-top: 10px;\n    margin-bottom: 10px;\n  }\n  .sm-bottom-cta-text {\n    font-family: 'Inter', sans-serif;\n    color: #475D70;\n    font-size: 15px;\n    margin: 0 auto 18px;\n    max-width: 680px;\n    line-height: 1.5;\n  }\n  .sm-inquire-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 13px 26px;\n    background-color: #FFFFFF;\n    color: #102C40;\n    border: 1px solid #102C40;\n    border-radius: 8px;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: none;\n    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  .sm-inquire-btn:hover {\n    background-color: #102C40;\n    color: #FFFFFF;\n    border-color: #102C40;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 18px rgba(16, 44, 64, 0.25);\n  }\n\n  /* 5. POPUP MODAL STYLES (\"Book Your Free Practice Audit\") */\n  .sm-modal-backdrop {\n    display: none;\n    position: fixed !important;\n    top: 0 !important;\n    left: 0 !important;\n    right: 0 !important;\n    bottom: 0 !important;\n    width: 100vw !important;\n    height: 100vh !important;\n    background: rgba(16, 44, 64, 0.65) !important;\n    backdrop-filter: blur(4px) !important;\n    -webkit-backdrop-filter: blur(4px) !important;\n    z-index: 99999999 !important;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    box-sizing: border-box;\n  }\n  .sm-modal-dialog {\n    background: #FFFFFF;\n    border-radius: 18px;\n    width: 100%;\n    max-width: 580px;\n    max-height: 92vh;\n    overflow-y: auto;\n    box-shadow: 0 25px 50px -12px rgba(16, 44, 64, 0.45);\n    box-sizing: border-box;\n    padding: 28px 28px 24px;\n    position: relative;\n    font-family: 'Inter', sans-serif;\n    animation: smModalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  @keyframes smModalPop {\n    0% { opacity: 0; transform: scale(0.95) translateY(10px); }\n    100% { opacity: 1; transform: scale(1) translateY(0); }\n  }\n  @media (max-width: 600px) {\n    .sm-modal-dialog {\n      padding: 22px 18px;\n    }\n  }\n  .sm-modal-close-btn {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #F1F5F9;\n    border: none;\n    color: #475D70;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    font-size: 16px;\n    font-weight: 700;\n    transition: background 0.2s, color 0.2s;\n  }\n  .sm-modal-close-btn:hover {\n    background: #E2E8F0;\n    color: #102C40;\n  }\n  .sm-modal-badge {\n    display: inline-block;\n    padding: 4px 12px;\n    background-color: #EAF8F8;\n    color: #179A9E;\n    border-radius: 50px;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n  .sm-modal-title {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 22px;\n    font-weight: 800;\n    color: #102C40;\n    margin: 0 0 4px 0;\n    line-height: 1.25;\n  }\n  .sm-modal-subtitle {\n    font-size: 13.5px;\n    color: #475D70;\n    margin-bottom: 20px;\n    line-height: 1.4;\n  }\n\n  /* Form Layout */\n  .sm-form-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    margin-bottom: 12px;\n  }\n  @media (max-width: 520px) {\n    .sm-form-row {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n  }\n  .sm-form-group {\n    display: flex;\n    flex-direction: column;\n    margin-bottom: 12px;\n  }\n  .sm-form-label {\n    font-size: 12.5px;\n    font-weight: 700;\n    color: #102C40;\n    margin-bottom: 5px;\n  }\n  .sm-form-input, .sm-form-select, .sm-form-textarea {\n    box-sizing: border-box;\n    width: 100%;\n    padding: 10px 12px;\n    border-radius: 8px;\n    border: 1px solid #D1D5DB;\n    font-family: 'Inter', sans-serif;\n    font-size: 13.5px;\n    color: #102C40;\n    background-color: #FFFFFF;\n    outline: none;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n  }\n  .sm-form-input:focus, .sm-form-select:focus, .sm-form-textarea:focus {\n    border-color: #179A9E;\n    box-shadow: 0 0 0 3px rgba(23, 154, 158, 0.15);\n  }\n  .sm-form-textarea {\n    resize: vertical;\n    min-height: 60px;\n  }\n\n  /* HIPAA Notice */\n  .sm-hipaa-notice {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 11.5px;\n    color: #64748B;\n    margin: 8px 0 18px;\n    line-height: 1.35;\n  }\n  .sm-hipaa-notice svg {\n    color: #179A9E;\n    flex-shrink: 0;\n  }\n\n  /* Submit Button */\n  .sm-modal-submit-btn {\n    width: 100%;\n    padding: 13px 20px;\n    background-color: #179A9E;\n    color: #FFFFFF;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n    box-shadow: 0 4px 12px rgba(23, 154, 158, 0.25);\n  }\n  .sm-modal-submit-btn:hover {\n    background-color: #102C40;\n    transform: translateY(-2px);\n  }\n\n  /* Success View */\n  .sm-modal-success {\n    display: none;\n    text-align: center;\n    padding: 24px 8px;\n  }\n  .sm-modal-success-icon {\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background-color: #EAF8F8;\n    color: #179A9E;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 auto 16px;\n  }\n</style>\n\n<!-- Live Specialty Search Bar -->\n<div class=\"sm-spec-search-container\">\n  <div class=\"sm-spec-search-icon\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n      <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>\n    </svg>\n  </div>\n  <input \n    type=\"text\" \n    id=\"sm-spec-search-input\" \n    class=\"sm-spec-search-input\" \n    placeholder=\"Search your medical specialty...\"\n    autocomplete=\"off\"\n  />\n</div>\n\n<!-- 28 Specialty Cards Grid (NO HOVER LIFT) -->\n<div class=\"sm-spec-grid\" id=\"sm-spec-grid\">\n  \n    <div class=\"sm-spec-card\" data-name=\"primary care\" data-cat=\"general medicine\" onclick=\"window.smOpenAuditModal('Specialty: Primary Care')\">\n      <div class=\"sm-spec-cat\">General Medicine</div>\n      <div class=\"sm-spec-name\">Primary Care</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"family medicine\" data-cat=\"general medicine\" onclick=\"window.smOpenAuditModal('Specialty: Family Medicine')\">\n      <div class=\"sm-spec-cat\">General Medicine</div>\n      <div class=\"sm-spec-name\">Family Medicine</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"internal medicine\" data-cat=\"general medicine\" onclick=\"window.smOpenAuditModal('Specialty: Internal Medicine')\">\n      <div class=\"sm-spec-cat\">General Medicine</div>\n      <div class=\"sm-spec-name\">Internal Medicine</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"pediatrics\" data-cat=\"pediatric care\" onclick=\"window.smOpenAuditModal('Specialty: Pediatrics')\">\n      <div class=\"sm-spec-cat\">Pediatric Care</div>\n      <div class=\"sm-spec-name\">Pediatrics</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"cardiology\" data-cat=\"cardiovascular\" onclick=\"window.smOpenAuditModal('Specialty: Cardiology')\">\n      <div class=\"sm-spec-cat\">Cardiovascular</div>\n      <div class=\"sm-spec-name\">Cardiology</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"vascular surgery\" data-cat=\"cardiovascular\" onclick=\"window.smOpenAuditModal('Specialty: Vascular Surgery')\">\n      <div class=\"sm-spec-cat\">Cardiovascular</div>\n      <div class=\"sm-spec-name\">Vascular Surgery</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"neurology\" data-cat=\"neurosciences\" onclick=\"window.smOpenAuditModal('Specialty: Neurology')\">\n      <div class=\"sm-spec-cat\">Neurosciences</div>\n      <div class=\"sm-spec-name\">Neurology</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"neurosurgery\" data-cat=\"neurosciences\" onclick=\"window.smOpenAuditModal('Specialty: Neurosurgery')\">\n      <div class=\"sm-spec-cat\">Neurosciences</div>\n      <div class=\"sm-spec-name\">Neurosurgery</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"psychiatry\" data-cat=\"mental health\" onclick=\"window.smOpenAuditModal('Specialty: Psychiatry')\">\n      <div class=\"sm-spec-cat\">Mental Health</div>\n      <div class=\"sm-spec-name\">Psychiatry</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"mental health\" data-cat=\"mental health\" onclick=\"window.smOpenAuditModal('Specialty: Mental Health')\">\n      <div class=\"sm-spec-cat\">Mental Health</div>\n      <div class=\"sm-spec-name\">Mental Health</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"ob/gyn\" data-cat=\"women's health\" onclick=\"window.smOpenAuditModal('Specialty: OB/GYN')\">\n      <div class=\"sm-spec-cat\">Women's Health</div>\n      <div class=\"sm-spec-name\">OB/GYN</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"general surgery\" data-cat=\"surgical care\" onclick=\"window.smOpenAuditModal('Specialty: General Surgery')\">\n      <div class=\"sm-spec-cat\">Surgical Care</div>\n      <div class=\"sm-spec-name\">General Surgery</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"thoracic surgery\" data-cat=\"surgical care\" onclick=\"window.smOpenAuditModal('Specialty: Thoracic Surgery')\">\n      <div class=\"sm-spec-cat\">Surgical Care</div>\n      <div class=\"sm-spec-name\">Thoracic Surgery</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"orthopedics\" data-cat=\"musculoskeletal\" onclick=\"window.smOpenAuditModal('Specialty: Orthopedics')\">\n      <div class=\"sm-spec-cat\">Musculoskeletal</div>\n      <div class=\"sm-spec-name\">Orthopedics</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"chiropractic\" data-cat=\"musculoskeletal\" onclick=\"window.smOpenAuditModal('Specialty: Chiropractic')\">\n      <div class=\"sm-spec-cat\">Musculoskeletal</div>\n      <div class=\"sm-spec-name\">Chiropractic</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"physical therapy\" data-cat=\"rehabilitation\" onclick=\"window.smOpenAuditModal('Specialty: Physical Therapy')\">\n      <div class=\"sm-spec-cat\">Rehabilitation</div>\n      <div class=\"sm-spec-name\">Physical Therapy</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"podiatry\" data-cat=\"specialized care\" onclick=\"window.smOpenAuditModal('Specialty: Podiatry')\">\n      <div class=\"sm-spec-cat\">Specialized Care</div>\n      <div class=\"sm-spec-name\">Podiatry</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"dental\" data-cat=\"specialized care\" onclick=\"window.smOpenAuditModal('Specialty: Dental')\">\n      <div class=\"sm-spec-cat\">Specialized Care</div>\n      <div class=\"sm-spec-name\">Dental</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"vision\" data-cat=\"specialized care\" onclick=\"window.smOpenAuditModal('Specialty: Vision')\">\n      <div class=\"sm-spec-cat\">Specialized Care</div>\n      <div class=\"sm-spec-name\">Vision</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"ent\" data-cat=\"specialized care\" onclick=\"window.smOpenAuditModal('Specialty: ENT')\">\n      <div class=\"sm-spec-cat\">Specialized Care</div>\n      <div class=\"sm-spec-name\">ENT</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"urology\" data-cat=\"specialized care\" onclick=\"window.smOpenAuditModal('Specialty: Urology')\">\n      <div class=\"sm-spec-cat\">Specialized Care</div>\n      <div class=\"sm-spec-name\">Urology</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"pulmonology\" data-cat=\"pulmonary & respiratory\" onclick=\"window.smOpenAuditModal('Specialty: Pulmonology')\">\n      <div class=\"sm-spec-cat\">Pulmonary & Respiratory</div>\n      <div class=\"sm-spec-name\">Pulmonology</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"nephrology\" data-cat=\"renal & kidney\" onclick=\"window.smOpenAuditModal('Specialty: Nephrology')\">\n      <div class=\"sm-spec-cat\">Renal & Kidney</div>\n      <div class=\"sm-spec-name\">Nephrology</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"digestive health\" data-cat=\"gastroenterology\" onclick=\"window.smOpenAuditModal('Specialty: Digestive Health')\">\n      <div class=\"sm-spec-cat\">Gastroenterology</div>\n      <div class=\"sm-spec-name\">Digestive Health</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"urgent care\" data-cat=\"acute care\" onclick=\"window.smOpenAuditModal('Specialty: Urgent Care')\">\n      <div class=\"sm-spec-cat\">Acute Care</div>\n      <div class=\"sm-spec-name\">Urgent Care</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"emergency room / emergency medicine\" data-cat=\"acute care\" onclick=\"window.smOpenAuditModal('Specialty: Emergency Room / Emergency Medicine')\">\n      <div class=\"sm-spec-cat\">Acute Care</div>\n      <div class=\"sm-spec-name\">Emergency Room / Emergency Medicine</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"home health\" data-cat=\"outreach & home\" onclick=\"window.smOpenAuditModal('Specialty: Home Health')\">\n      <div class=\"sm-spec-cat\">Outreach & Home</div>\n      <div class=\"sm-spec-name\">Home Health</div>\n    </div>\n  \n    <div class=\"sm-spec-card\" data-name=\"dme\" data-cat=\"equipment & supplies\" onclick=\"window.smOpenAuditModal('Specialty: DME')\">\n      <div class=\"sm-spec-cat\">Equipment & Supplies</div>\n      <div class=\"sm-spec-name\">DME</div>\n    </div>\n  \n</div>\n\n<!-- No Results Alert -->\n<div class=\"sm-spec-empty\" id=\"sm-spec-empty\">\n  No medical specialties match your search. Click below to inquire about custom payer guidelines.\n</div>\n\n<!-- Bottom CTA & Button (Direct click trigger) -->\n<div class=\"sm-bottom-cta-wrap\">\n  <p class=\"sm-bottom-cta-text\">\n    Don't see your specific multi-disciplinary clinic listed? We support custom payer rule sets for any clinical setting.\n  </p>\n  <button \n    type=\"button\" \n    class=\"sm-inquire-btn\" \n    id=\"sm-inquire-specialty-btn\" \n    onclick=\"window.smOpenAuditModal('Specialties Consultation')\"\n  >\n    <span>Inquire About Your Specialty</span>\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n      <polyline points=\"12 5 19 12 12 19\"></polyline>\n    </svg>\n  </button>\n</div>\n\n<!-- POPUP MODAL FORM (\"Book Your Free Practice Audit\") -->\n<div class=\"sm-modal-backdrop\" id=\"sm-audit-modal\" onclick=\"if(event.target===this) window.smCloseAuditModal();\">\n  <div class=\"sm-modal-dialog\">\n    <button type=\"button\" class=\"sm-modal-close-btn\" onclick=\"window.smCloseAuditModal()\" aria-label=\"Close modal\">✕</button>\n\n    <!-- Form View -->\n    <div id=\"sm-modal-form-view\">\n      <span class=\"sm-modal-badge\">COMPLIMENTARY • NO OBLIGATION</span>\n      <h3 class=\"sm-modal-title\">Book Your Free Practice Audit</h3>\n      <p class=\"sm-modal-subtitle\">Uncover hidden revenue leaks and optimize your billing workflows</p>\n\n      <form id=\"sm-audit-form\" onsubmit=\"window.smHandleAuditSubmit(event)\">\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Full Name *</label>\n            <input type=\"text\" id=\"sm-field-fullname\" class=\"sm-form-input\" required placeholder=\"Dr. Sarah Jenkins\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Professional Role</label>\n            <select id=\"sm-field-role\" class=\"sm-form-select\">\n              <option value=\"Practice Administrator\">Practice Administrator</option>\n              <option value=\"Physician / Provider\">Physician / Provider</option>\n              <option value=\"Billing Manager\">Billing Manager</option>\n              <option value=\"Executive / C-Suite\">Executive / C-Suite</option>\n              <option value=\"Office Manager\">Office Manager</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Practice / Clinic Name *</label>\n            <input type=\"text\" id=\"sm-field-practice\" class=\"sm-form-input\" required placeholder=\"Apex Health Associates\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Clinical Specialty</label>\n            <select id=\"sm-field-specialty\" class=\"sm-form-select\">\n              <option value=\"Internal Medicine / Primary\">Internal Medicine / Primary</option>\n              <option value=\"Cardiology\">Cardiology</option>\n              <option value=\"Pediatrics\">Pediatrics</option>\n              <option value=\"Orthopedic Surgery\">Orthopedic Surgery</option>\n              <option value=\"Mental Health\">Mental Health / Psychiatry</option>\n              <option value=\"General Surgery\">General Surgery</option>\n              <option value=\"Dermatology\">Dermatology</option>\n              <option value=\"Multi-Specialty\">Multi-Specialty Clinic</option>\n              <option value=\"Other\">Other Clinical Specialty</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Work Email Address *</label>\n            <input type=\"email\" id=\"sm-field-email\" class=\"sm-form-input\" required placeholder=\"sjenkins@apexhealth.com\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Phone Number *</label>\n            <input type=\"tel\" id=\"sm-field-phone\" class=\"sm-form-input\" required placeholder=\"(555) 019-2834\" />\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Monthly Collections Volume</label>\n            <select id=\"sm-field-volume\" class=\"sm-form-select\">\n              <option value=\"$100,000 - $250,000 / mo\">$100,000 - $250,000 / mo</option>\n              <option value=\"Under $50,000 / mo\">Under $50,000 / mo</option>\n              <option value=\"$50,000 - $100,000 / mo\">$50,000 - $100,000 / mo</option>\n              <option value=\"$250,000 - $500,000 / mo\">$250,000 - $500,000 / mo</option>\n              <option value=\"$500,000+ / mo\">$500,000+ / mo</option>\n            </select>\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Preferred Audit Date</label>\n            <input type=\"date\" id=\"sm-field-date\" class=\"sm-form-input\" />\n          </div>\n        </div>\n\n        <div class=\"sm-form-group\">\n          <label class=\"sm-form-label\">Billing Challenges or Questions</label>\n          <textarea id=\"sm-field-notes\" class=\"sm-form-textarea\" rows=\"2\" placeholder=\"Tell us about high denial rates, A/R backlogs, or specific payer bottlenecks...\">Interested in: Specialties Consultation</textarea>\n        </div>\n\n        <div class=\"sm-hipaa-notice\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n          </svg>\n          <span>Your practice information is kept 100% confidential under HIPAA strict privacy guidelines.</span>\n        </div>\n\n        <button type=\"submit\" class=\"sm-modal-submit-btn\" id=\"sm-btn-submit\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line>\n            <polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon>\n          </svg>\n          <span>Confirm Free Consultation &amp; Audit</span>\n        </button>\n      </form>\n    </div>\n\n    <!-- Success View -->\n    <div id=\"sm-modal-success-view\" class=\"sm-modal-success\">\n      <div class=\"sm-modal-success-icon\">\n        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <polyline points=\"20 6 9 17 4 12\"></polyline>\n        </svg>\n      </div>\n      <h3 style=\"font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;color:#102C40;margin:0 0 8px;\">Audit Request Received!</h3>\n      <p style=\"color:#475D70;font-size:14px;line-height:1.5;margin-bottom:20px;\">\n        Thank you! Our senior healthcare billing director will review your specialty requirements and contact you within 24 hours.\n      </p>\n      <button type=\"button\" class=\"sm-modal-submit-btn\" onclick=\"window.smCloseAuditModal()\">\n        <span>Return to Website</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n<script>\n  // 1. Dynamic Live Search Filter\n  (function initSpecialtySearch() {\n    function setup() {\n      var searchInput = document.getElementById('sm-spec-search-input');\n      var grid = document.getElementById('sm-spec-grid');\n      var emptyMsg = document.getElementById('sm-spec-empty');\n      if (!searchInput || !grid) return;\n\n      var cards = grid.querySelectorAll('.sm-spec-card');\n\n      searchInput.addEventListener('input', function() {\n        var query = searchInput.value.toLowerCase().trim();\n        var visibleCount = 0;\n\n        cards.forEach(function(card) {\n          var name = card.getAttribute('data-name') || '';\n          var cat = card.getAttribute('data-cat') || '';\n          if (!query || name.indexOf(query) !== -1 || cat.indexOf(query) !== -1) {\n            card.style.display = 'flex';\n            visibleCount++;\n          } else {\n            card.style.display = 'none';\n          }\n        });\n\n        if (emptyMsg) {\n          emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';\n        }\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', setup);\n    } else {\n      setup();\n    }\n  })();\n\n  // 2. Modal Open / Close Functions (Teleported to body so no container clips it)\n  window.smOpenAuditModal = function(prefill) {\n    var modal = document.getElementById('sm-audit-modal');\n    if (!modal) return;\n\n    // Teleport modal to document.body to break out of any Elementor container\n    if (modal.parentElement !== document.body) {\n      document.body.appendChild(modal);\n    }\n\n    var formView = document.getElementById('sm-modal-form-view');\n    var successView = document.getElementById('sm-modal-success-view');\n    if (formView) formView.style.display = 'block';\n    if (successView) successView.style.display = 'none';\n\n    if (prefill) {\n      var notes = document.getElementById('sm-field-notes');\n      if (notes) notes.value = 'Interested in: ' + prefill;\n    }\n\n    modal.style.display = 'flex';\n    document.body.style.overflow = 'hidden';\n  };\n\n  window.smCloseAuditModal = function() {\n    var modal = document.getElementById('sm-audit-modal');\n    if (!modal) return;\n    modal.style.display = 'none';\n    document.body.style.overflow = '';\n  };\n\n  window.smHandleAuditSubmit = function(e) {\n    e.preventDefault();\n    var btn = document.getElementById('sm-btn-submit');\n    if (btn) btn.innerHTML = '<span>Processing Audit Request...</span>';\n\n    setTimeout(function() {\n      var formView = document.getElementById('sm-modal-form-view');\n      var successView = document.getElementById('sm-modal-success-view');\n      if (formView) formView.style.display = 'none';\n      if (successView) successView.style.display = 'block';\n      if (btn) btn.innerHTML = '<span>Confirm Free Consultation &amp; Audit</span>';\n    }, 600);\n  };\n\n  // 3. Bulletproof Global Click Delegation (Capture Phase)\n  document.addEventListener('click', function(e) {\n    var trigger = e.target.closest(\n      '#sm-inquire-specialty-btn, ' +\n      '.sm-inquire-btn, ' +\n      'a[href=\"#open-audit-modal\"], ' +\n      'a[href*=\"audit\"], ' +\n      'a[href*=\"specialt\"], ' +\n      '.sm-spec-card'\n    );\n\n    if (trigger) {\n      if (trigger.classList.contains('sm-spec-card')) {\n        var name = trigger.getAttribute('data-name') || '';\n        window.smOpenAuditModal('Specialty: ' + name);\n        return;\n      }\n      \n      e.preventDefault();\n      e.stopPropagation();\n      window.smOpenAuditModal('Specialties Consultation');\n      return;\n    }\n\n    // Also catch any button with the text\n    var btn = e.target.closest('button, a');\n    if (btn && btn.textContent && btn.textContent.indexOf('Inquire About Your Specialty') !== -1) {\n      e.preventDefault();\n      e.stopPropagation();\n      window.smOpenAuditModal('Specialties Consultation');\n      return;\n    }\n  }, true);\n\n  // Close on Escape key\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape') {\n      window.smCloseAuditModal();\n    }\n  });\n</script>\n"
              }
            }
          ]
        }
      ]
    }
  ]
