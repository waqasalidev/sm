            {
              "id": "52cemqv",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<!-- PRACTICE REVENUE RECOVERY ESTIMATOR (ROI CALCULATOR) -->\n<div class=\"sm-calc-wrapper\" id=\"sm-roi-calculator\">\n  <div class=\"sm-calc-card\">\n    <div class=\"sm-calc-grid\">\n      \n      <!-- LEFT COLUMN: INPUT CONTROLS -->\n      <div class=\"sm-calc-inputs-col\">\n        \n        <!-- 1. Monthly Practice Billings Slider -->\n        <div class=\"sm-calc-field-group\">\n          <div class=\"sm-calc-label-row\">\n            <label class=\"sm-calc-label\" for=\"sm-billings-range\">Current Monthly Practice Billings</label>\n            <span class=\"sm-calc-val-badge\" id=\"sm-billings-display\">$120,000 / mo</span>\n          </div>\n          \n          <div class=\"sm-slider-container\">\n            <input \n              type=\"range\" \n              id=\"sm-billings-range\" \n              class=\"sm-calc-slider\" \n              min=\"30000\" \n              max=\"1000000\" \n              step=\"5000\" \n              value=\"120000\"\n              aria-label=\"Current Monthly Practice Billings\"\n            />\n            <div class=\"sm-slider-track-fill\" id=\"sm-billings-fill\"></div>\n          </div>\n          \n          <div class=\"sm-calc-scale-labels\">\n            <span>$30k/mo</span>\n            <span>$500k/mo</span>\n            <span>$1M+/mo</span>\n          </div>\n        </div>\n\n        <!-- 2. Primary Medical Specialty Select -->\n        <div class=\"sm-calc-field-group\">\n          <label class=\"sm-calc-label\" for=\"sm-specialty-select\">Primary Medical Specialty</label>\n          <div class=\"sm-select-wrapper\">\n            <select id=\"sm-specialty-select\" class=\"sm-calc-select\" aria-label=\"Primary Medical Specialty\">\n              <option value=\"internal-medicine\" data-rate=\"0.180\" data-ar-before=\"53\" data-ar-after=\"26\" data-clean=\"98.5\" selected>Internal Medicine / Primary Care</option>\n              <option value=\"cardiology\" data-rate=\"0.195\" data-ar-before=\"55\" data-ar-after=\"25\" data-clean=\"98.8\">Cardiology</option>\n              <option value=\"pediatrics\" data-rate=\"0.175\" data-ar-before=\"49\" data-ar-after=\"24\" data-clean=\"98.4\">Pediatrics</option>\n              <option value=\"orthopedics\" data-rate=\"0.210\" data-ar-before=\"58\" data-ar-after=\"27\" data-clean=\"98.7\">Orthopedic Surgery</option>\n              <option value=\"mental-health\" data-rate=\"0.185\" data-ar-before=\"54\" data-ar-after=\"26\" data-clean=\"98.3\">Mental Health / Psychiatry</option>\n              <option value=\"general-surgery\" data-rate=\"0.205\" data-ar-before=\"56\" data-ar-after=\"26\" data-clean=\"98.6\">General Surgery</option>\n              <option value=\"dermatology\" data-rate=\"0.180\" data-ar-before=\"50\" data-ar-after=\"24\" data-clean=\"98.9\">Dermatology</option>\n              <option value=\"ob-gyn\" data-rate=\"0.190\" data-ar-before=\"52\" data-ar-after=\"25\" data-clean=\"98.5\">OB/GYN</option>\n              <option value=\"neurology\" data-rate=\"0.215\" data-ar-before=\"57\" data-ar-after=\"27\" data-clean=\"98.6\">Neurology &amp; Neurosurgery</option>\n              <option value=\"physical-therapy\" data-rate=\"0.170\" data-ar-before=\"48\" data-ar-after=\"23\" data-clean=\"98.2\">Physical Therapy &amp; Chiropractic</option>\n              <option value=\"podiatry\" data-rate=\"0.180\" data-ar-before=\"51\" data-ar-after=\"25\" data-clean=\"98.4\">Podiatry</option>\n              <option value=\"multi-specialty\" data-rate=\"0.200\" data-ar-before=\"56\" data-ar-after=\"26\" data-clean=\"98.8\">Multi-Specialty Clinic</option>\n              <option value=\"other\" data-rate=\"0.180\" data-ar-before=\"53\" data-ar-after=\"26\" data-clean=\"98.5\">Other Specialty</option>\n            </select>\n            <div class=\"sm-select-chevron\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <polyline points=\"6 9 12 15 18 9\"></polyline>\n              </svg>\n            </div>\n          </div>\n        </div>\n\n        <!-- 3. Number of Billing Providers Slider -->\n        <div class=\"sm-calc-field-group\">\n          <div class=\"sm-calc-label-row\">\n            <label class=\"sm-calc-label\" for=\"sm-providers-range\">Number of Billing Providers</label>\n            <span class=\"sm-calc-val-badge\" id=\"sm-providers-display\">3 Providers</span>\n          </div>\n          \n          <div class=\"sm-slider-container\">\n            <input \n              type=\"range\" \n              id=\"sm-providers-range\" \n              class=\"sm-calc-slider\" \n              min=\"1\" \n              max=\"25\" \n              step=\"1\" \n              value=\"3\"\n              aria-label=\"Number of Billing Providers\"\n            />\n            <div class=\"sm-slider-track-fill\" id=\"sm-providers-fill\"></div>\n          </div>\n          \n          <div class=\"sm-calc-scale-labels\">\n            <span>1 Provider</span>\n            <span>10 Providers</span>\n            <span>25+ Providers</span>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- RIGHT COLUMN: RESULTS SUMMARY CARD -->\n      <div class=\"sm-calc-results-col\">\n        <div class=\"sm-calc-results-card\">\n          \n          <div class=\"sm-results-eyebrow\">ESTIMATED ANNUAL REVENUE RECAPTURED</div>\n          <div class=\"sm-results-amount\" id=\"sm-annual-recaptured\">$259,200</div>\n          <div class=\"sm-results-footnote\">*Based on average 18% - 22% denial recovery &amp; underpayment audits</div>\n\n          <div class=\"sm-results-divider\"></div>\n\n          <!-- Key Metrics -->\n          <div class=\"sm-results-metrics-grid\">\n            <div class=\"sm-metric-item\">\n              <div class=\"sm-metric-label\">A/R Days Reduction</div>\n              <div class=\"sm-metric-value\" id=\"sm-metric-ar\">\n                <span class=\"sm-metric-before\">53d</span>\n                <span class=\"sm-metric-arrow\">→</span>\n                <span class=\"sm-metric-after\">26 days</span>\n              </div>\n            </div>\n\n            <div class=\"sm-metric-item\">\n              <div class=\"sm-metric-label\">Target Clean Claims</div>\n              <div class=\"sm-metric-value\" id=\"sm-metric-clean\">98.5%</div>\n            </div>\n          </div>\n\n          <!-- Feature Bullets -->\n          <div class=\"sm-results-features\">\n            <div class=\"sm-feature-point\">\n              <div class=\"sm-feature-icon\">\n                <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                  <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                </svg>\n              </div>\n              <span class=\"sm-feature-text\">Elimination of payer denial backlogs</span>\n            </div>\n\n            <div class=\"sm-feature-point\">\n              <div class=\"sm-feature-icon\">\n                <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                  <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                </svg>\n              </div>\n              <span class=\"sm-feature-text\">Real-time EHR clearinghouse claim validation</span>\n            </div>\n          </div>\n\n          <!-- CTA Button -> OPENS AUDIT MODAL FORM -->\n          <button \n            type=\"button\" \n            class=\"sm-calc-cta-btn\" \n            id=\"sm-calc-claim-audit-btn\"\n            onclick=\"window.smOpenAuditModalFromCalculator()\"\n          >\n            <span>Claim Your Detailed Practice Audit</span>\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n              <polyline points=\"12 5 19 12 12 19\"></polyline>\n            </svg>\n          </button>\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<!-- POPUP MODAL FORM (\"Book Your Free Practice Audit\") -->\n<div \n  class=\"sm-modal-backdrop\" \n  id=\"sm-audit-modal\" \n  onclick=\"if(event.target===this){ this.style.setProperty('display', 'none', 'important'); var allM=document.querySelectorAll('.sm-modal-backdrop'); for(var i=0;i<allM.length;i++){ allM[i].style.setProperty('display', 'none', 'important'); } document.body.style.overflow=''; if(window.smCloseAuditModal) window.smCloseAuditModal(); }\"\n>\n  <div class=\"sm-modal-dialog\">\n    <!-- Bulletproof Close Button with inline DOM closer + z-index 999999999 -->\n    <button \n      type=\"button\" \n      class=\"sm-modal-close-btn\" \n      onclick=\"if(this.closest('.sm-modal-backdrop')){ this.closest('.sm-modal-backdrop').style.setProperty('display', 'none', 'important'); } var allM=document.querySelectorAll('.sm-modal-backdrop'); for(var i=0;i<allM.length;i++){ allM[i].style.setProperty('display', 'none', 'important'); allM[i].style.display='none'; } document.body.style.overflow=''; if(window.smCloseAuditModal){ window.smCloseAuditModal(); }\" \n      aria-label=\"Close modal\"\n    >✕</button>\n\n    <!-- Form View -->\n    <div id=\"sm-modal-form-view\">\n      <span class=\"sm-modal-badge\">COMPLIMENTARY • NO OBLIGATION</span>\n      <h3 class=\"sm-modal-title\">Book Your Free Practice Audit</h3>\n      <p class=\"sm-modal-subtitle\">Uncover hidden revenue leaks and optimize your billing workflows</p>\n\n      <form id=\"sm-audit-form\" onsubmit=\"window.smHandleAuditSubmit(event)\">\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Full Name *</label>\n            <input type=\"text\" id=\"sm-field-fullname\" class=\"sm-form-input\" required placeholder=\"Dr. Sarah Jenkins\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Professional Role</label>\n            <select id=\"sm-field-role\" class=\"sm-form-select\">\n              <option value=\"Practice Administrator\">Practice Administrator</option>\n              <option value=\"Physician / Provider\">Physician / Provider</option>\n              <option value=\"Billing Manager\">Billing Manager</option>\n              <option value=\"Executive / C-Suite\">Executive / C-Suite</option>\n              <option value=\"Office Manager\">Office Manager</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Practice / Clinic Name *</label>\n            <input type=\"text\" id=\"sm-field-practice\" class=\"sm-form-input\" required placeholder=\"Apex Health Associates\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Clinical Specialty</label>\n            <select id=\"sm-field-specialty\" class=\"sm-form-select\">\n              <option value=\"Internal Medicine / Primary Care\">Internal Medicine / Primary Care</option>\n              <option value=\"Cardiology\">Cardiology</option>\n              <option value=\"Pediatrics\">Pediatrics</option>\n              <option value=\"Orthopedic Surgery\">Orthopedic Surgery</option>\n              <option value=\"Mental Health / Psychiatry\">Mental Health / Psychiatry</option>\n              <option value=\"General Surgery\">General Surgery</option>\n              <option value=\"Dermatology\">Dermatology</option>\n              <option value=\"OB/GYN\">OB/GYN</option>\n              <option value=\"Neurology & Neurosurgery\">Neurology &amp; Neurosurgery</option>\n              <option value=\"Physical Therapy & Chiropractic\">Physical Therapy &amp; Chiropractic</option>\n              <option value=\"Podiatry\">Podiatry</option>\n              <option value=\"Multi-Specialty Clinic\">Multi-Specialty Clinic</option>\n              <option value=\"Other Clinical Specialty\">Other Clinical Specialty</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Work Email Address *</label>\n            <input type=\"email\" id=\"sm-field-email\" class=\"sm-form-input\" required placeholder=\"sjenkins@apexhealth.com\" />\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Phone Number *</label>\n            <input type=\"tel\" id=\"sm-field-phone\" class=\"sm-form-input\" required placeholder=\"(555) 019-2834\" />\n          </div>\n        </div>\n\n        <div class=\"sm-form-row\">\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Monthly Collections Volume</label>\n            <select id=\"sm-field-volume\" class=\"sm-form-select\">\n              <option value=\"$100,000 - $250,000 / mo\">$100,000 - $250,000 / mo</option>\n              <option value=\"Under $50,000 / mo\">Under $50,000 / mo</option>\n              <option value=\"$50,000 - $100,000 / mo\">$50,000 - $100,000 / mo</option>\n              <option value=\"$250,000 - $500,000 / mo\">$250,000 - $500,000 / mo</option>\n              <option value=\"$500,000+ / mo\">$500,000+ / mo</option>\n            </select>\n          </div>\n          <div class=\"sm-form-group\">\n            <label class=\"sm-form-label\">Preferred Audit Date</label>\n            <input type=\"date\" id=\"sm-field-date\" class=\"sm-form-input\" />\n          </div>\n        </div>\n\n        <div class=\"sm-form-group\">\n          <label class=\"sm-form-label\">Billing Challenges or Questions</label>\n          <textarea id=\"sm-field-notes\" class=\"sm-form-textarea\" rows=\"2\" placeholder=\"Tell us about high denial rates, A/R backlogs, or specific payer bottlenecks...\">Interested in: Practice Revenue Recovery Audit</textarea>\n        </div>\n\n        <div class=\"sm-hipaa-notice\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n          </svg>\n          <span>Your practice information is kept 100% confidential under HIPAA strict privacy guidelines.</span>\n        </div>\n\n        <button type=\"submit\" class=\"sm-modal-submit-btn\" id=\"sm-btn-submit\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line>\n            <polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon>\n          </svg>\n          <span>Confirm Free Consultation &amp; Audit</span>\n        </button>\n      </form>\n    </div>\n\n    <!-- Success View -->\n    <div id=\"sm-modal-success-view\" class=\"sm-modal-success\">\n      <div class=\"sm-modal-success-icon\">\n        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <polyline points=\"20 6 9 17 4 12\"></polyline>\n        </svg>\n      </div>\n      <h3 style=\"font-family:'Plus Jakarta Sans',sans-serif;font-size:22px;color:#102C40;margin:0 0 8px;\">Audit Request Received!</h3>\n      <p style=\"color:#475D70;font-size:14px;line-height:1.5;margin-bottom:20px;\">\n        Thank you! Our senior healthcare billing director will review your specialty requirements and contact you within 24 hours.\n      </p>\n      <button \n        type=\"button\" \n        class=\"sm-modal-submit-btn\" \n        onclick=\"if(this.closest('.sm-modal-backdrop')){ this.closest('.sm-modal-backdrop').style.setProperty('display', 'none', 'important'); } var allM=document.querySelectorAll('.sm-modal-backdrop'); for(var i=0;i<allM.length;i++){ allM[i].style.setProperty('display', 'none', 'important'); } document.body.style.overflow=''; if(window.smCloseAuditModal) window.smCloseAuditModal();\"\n      >\n        <span>Return to Website</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* ===================================================\n     1. CALCULATOR MAIN WRAPPER & CONTAINER\n     =================================================== */\n  .sm-calc-wrapper {\n    width: 100%;\n    max-width: 1060px;\n    margin: 0 auto;\n    box-sizing: border-box;\n    font-family: 'Inter', sans-serif;\n  }\n  .sm-calc-card {\n    background: #0B202E;\n    border: 1px solid rgba(56, 212, 216, 0.18);\n    border-radius: 22px;\n    padding: 38px 40px;\n    box-sizing: border-box;\n    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);\n  }\n  @media (max-width: 768px) {\n    .sm-calc-card {\n      padding: 26px 18px;\n      border-radius: 16px;\n    }\n  }\n\n  /* Two Column Grid */\n  .sm-calc-grid {\n    display: grid;\n    grid-template-columns: 1.15fr 1fr;\n    gap: 36px;\n    align-items: center;\n  }\n  @media (max-width: 900px) {\n    .sm-calc-grid {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n  }\n\n  /* ===================================================\n     2. LEFT COLUMN (SLIDERS & SELECT INPUTS)\n     =================================================== */\n  .sm-calc-inputs-col {\n    display: flex;\n    flex-direction: column;\n    gap: 26px;\n  }\n  .sm-calc-field-group {\n    display: flex;\n    flex-direction: column;\n  }\n  .sm-calc-label-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 12px;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  .sm-calc-label {\n    font-size: 14.5px;\n    font-weight: 700;\n    color: #FFFFFF;\n    line-height: 1.3;\n  }\n  .sm-calc-val-badge {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 16px;\n    font-weight: 800;\n    color: #2DD4BF;\n    letter-spacing: 0.3px;\n  }\n\n  /* Slider Container & Custom Range Styling */\n  .sm-slider-container {\n    position: relative;\n    width: 100%;\n    height: 24px;\n    display: flex;\n    align-items: center;\n  }\n  .sm-calc-slider {\n    -webkit-appearance: none;\n    appearance: none;\n    width: 100%;\n    height: 6px;\n    background: #16364A;\n    border-radius: 10px;\n    outline: none;\n    position: relative;\n    z-index: 2;\n    cursor: pointer;\n    margin: 0;\n  }\n  /* Webkit Thumb */\n  .sm-calc-slider::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    appearance: none;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #2DD4BF;\n    border: 3px solid #0B202E;\n    box-shadow: 0 0 10px rgba(45, 212, 191, 0.6);\n    cursor: pointer;\n    transition: transform 0.15s ease, box-shadow 0.15s ease;\n  }\n  .sm-calc-slider::-webkit-slider-thumb:hover {\n    transform: scale(1.15);\n    box-shadow: 0 0 16px rgba(45, 212, 191, 0.9);\n  }\n  /* Firefox Thumb */\n  .sm-calc-slider::-moz-range-thumb {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    background: #2DD4BF;\n    border: 3px solid #0B202E;\n    box-shadow: 0 0 10px rgba(45, 212, 191, 0.6);\n    cursor: pointer;\n  }\n\n  .sm-slider-track-fill {\n    position: absolute;\n    left: 0;\n    height: 6px;\n    background: linear-gradient(90deg, #179A9E, #2DD4BF);\n    border-radius: 10px;\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  /* Scale Sub-Labels */\n  .sm-calc-scale-labels {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 8px;\n    font-size: 11.5px;\n    font-weight: 500;\n    color: #64748B;\n  }\n\n  /* Select Dropdown */\n  .sm-select-wrapper {\n    position: relative;\n    width: 100%;\n    margin-top: 10px;\n  }\n  .sm-calc-select {\n    width: 100%;\n    box-sizing: border-box;\n    appearance: none;\n    -webkit-appearance: none;\n    -moz-appearance: none;\n    background: #0E2838;\n    border: 1px solid rgba(56, 212, 216, 0.28);\n    border-radius: 10px;\n    padding: 13px 44px 13px 16px;\n    font-family: 'Inter', sans-serif;\n    font-size: 14.5px;\n    color: #FFFFFF;\n    outline: none;\n    cursor: pointer;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n  }\n  .sm-calc-select:focus {\n    border-color: #2DD4BF;\n    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.18);\n  }\n  .sm-calc-select option {\n    background: #081824;\n    color: #FFFFFF;\n    padding: 10px;\n  }\n  .sm-select-chevron {\n    position: absolute;\n    right: 15px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: #2DD4BF;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n  }\n\n  /* ===================================================\n     3. RIGHT COLUMN (RESULTS CARD)\n     =================================================== */\n  .sm-calc-results-card {\n    background: rgba(12, 34, 48, 0.95);\n    border: 1.5px solid rgba(45, 212, 191, 0.35);\n    border-radius: 18px;\n    padding: 30px 28px;\n    box-sizing: border-box;\n    box-shadow: inset 0 0 30px rgba(23, 154, 158, 0.08);\n  }\n  @media (max-width: 600px) {\n    .sm-calc-results-card {\n      padding: 24px 18px;\n    }\n  }\n\n  .sm-results-eyebrow {\n    font-size: 11.5px;\n    font-weight: 800;\n    color: #2DD4BF;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n    margin-bottom: 6px;\n  }\n  .sm-results-amount {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 42px;\n    font-weight: 900;\n    color: #2DD4BF;\n    line-height: 1.15;\n    margin-bottom: 6px;\n    letter-spacing: -0.5px;\n  }\n  @media (max-width: 600px) {\n    .sm-results-amount {\n      font-size: 34px;\n    }\n  }\n\n  .sm-results-footnote {\n    font-size: 12px;\n    color: #94A3B8;\n    line-height: 1.4;\n    margin-bottom: 18px;\n  }\n\n  .sm-results-divider {\n    height: 1px;\n    background: rgba(255, 255, 255, 0.09);\n    margin: 18px 0;\n  }\n\n  /* Two Metrics Grid */\n  .sm-results-metrics-grid {\n    display: grid;\n    grid-template-columns: 1.2fr 1fr;\n    gap: 16px;\n    margin-bottom: 22px;\n  }\n  .sm-metric-item {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n  }\n  .sm-metric-label {\n    font-size: 11.5px;\n    font-weight: 600;\n    color: #94A3B8;\n  }\n  .sm-metric-value {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 17px;\n    font-weight: 800;\n    color: #FFFFFF;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .sm-metric-before {\n    color: #94A3B8;\n  }\n  .sm-metric-arrow {\n    color: #2DD4BF;\n    font-weight: 900;\n  }\n  .sm-metric-after {\n    color: #2DD4BF;\n  }\n  #sm-metric-clean {\n    color: #2DD4BF;\n  }\n\n  /* Feature Checklist */\n  .sm-results-features {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-bottom: 26px;\n  }\n  .sm-feature-point {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .sm-feature-icon {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    background: rgba(45, 212, 191, 0.12);\n    color: #2DD4BF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .sm-feature-text {\n    font-size: 13.5px;\n    color: #E2ECF2;\n    font-weight: 500;\n    line-height: 1.35;\n  }\n\n  /* CTA Button */\n  .sm-calc-cta-btn {\n    width: 100%;\n    box-sizing: border-box;\n    padding: 14px 20px;\n    background: #179A9E;\n    color: #FFFFFF;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    transition: background-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;\n    box-shadow: 0 4px 16px rgba(23, 154, 158, 0.35);\n  }\n  .sm-calc-cta-btn:hover {\n    background: #102C40;\n    color: #FFFFFF;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 24px rgba(16, 44, 64, 0.5);\n  }\n\n  /* ===================================================\n     4. POPUP AUDIT MODAL FORM STYLES\n     =================================================== */\n  .sm-modal-backdrop {\n    display: none;\n    position: fixed !important;\n    top: 0 !important;\n    left: 0 !important;\n    right: 0 !important;\n    bottom: 0 !important;\n    width: 100vw !important;\n    height: 100vh !important;\n    background: rgba(16, 44, 64, 0.75) !important;\n    backdrop-filter: blur(4px) !important;\n    -webkit-backdrop-filter: blur(4px) !important;\n    z-index: 99999999 !important;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    box-sizing: border-box;\n  }\n  .sm-modal-dialog {\n    background: #FFFFFF !important;\n    border-radius: 18px !important;\n    width: 100% !important;\n    max-width: 580px !important;\n    max-height: 92vh !important;\n    overflow-y: auto !important;\n    box-shadow: 0 25px 50px -12px rgba(16, 44, 64, 0.5) !important;\n    box-sizing: border-box !important;\n    padding: 30px 28px 24px !important;\n    position: relative !important;\n    font-family: 'Inter', sans-serif !important;\n    animation: smModalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;\n  }\n  @keyframes smModalPop {\n    0% { opacity: 0; transform: scale(0.95) translateY(12px); }\n    100% { opacity: 1; transform: scale(1) translateY(0); }\n  }\n  @media (max-width: 600px) {\n    .sm-modal-dialog {\n      padding: 22px 18px !important;\n    }\n  }\n\n  /* BULLETPROOF CLOSE BUTTON */\n  .sm-modal-close-btn {\n    position: absolute !important;\n    top: 16px !important;\n    right: 16px !important;\n    width: 40px !important;\n    height: 40px !important;\n    border-radius: 50% !important;\n    background: #F1F5F9 !important;\n    border: 1px solid #CBD5E1 !important;\n    color: #0F172A !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    cursor: pointer !important;\n    font-size: 20px !important;\n    font-weight: 800 !important;\n    line-height: 1 !important;\n    z-index: 999999999 !important;\n    pointer-events: auto !important;\n    touch-action: manipulation !important;\n    -webkit-tap-highlight-color: transparent !important;\n    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1) !important;\n  }\n  .sm-modal-close-btn:hover {\n    background: #E2E8F0 !important;\n    color: #E11D48 !important;\n    transform: scale(1.08) !important;\n  }\n  .sm-modal-close-btn:active {\n    transform: scale(0.92) !important;\n  }\n\n  .sm-modal-badge {\n    display: inline-block;\n    padding: 4px 12px;\n    background-color: #EAF8F8;\n    color: #179A9E;\n    border-radius: 50px;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n  .sm-modal-title {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 22px;\n    font-weight: 800;\n    color: #102C40;\n    margin: 0 0 4px 0;\n    line-height: 1.25;\n  }\n  .sm-modal-subtitle {\n    font-size: 13.5px;\n    color: #475D70;\n    margin-bottom: 20px;\n    line-height: 1.4;\n  }\n\n  .sm-form-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    margin-bottom: 12px;\n  }\n  @media (max-width: 520px) {\n    .sm-form-row {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n  }\n  .sm-form-group {\n    display: flex;\n    flex-direction: column;\n    margin-bottom: 12px;\n  }\n  .sm-form-label {\n    font-size: 12.5px;\n    font-weight: 700;\n    color: #102C40;\n    margin-bottom: 5px;\n  }\n  .sm-form-input, .sm-form-select, .sm-form-textarea {\n    box-sizing: border-box;\n    width: 100%;\n    padding: 10px 12px;\n    border-radius: 8px;\n    border: 1px solid #D1D5DB;\n    font-family: 'Inter', sans-serif;\n    font-size: 13.5px;\n    color: #102C40;\n    background-color: #FFFFFF;\n    outline: none;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n  }\n  .sm-form-input:focus, .sm-form-select:focus, .sm-form-textarea:focus {\n    border-color: #179A9E;\n    box-shadow: 0 0 0 3px rgba(23, 154, 158, 0.15);\n  }\n  .sm-form-textarea {\n    resize: vertical;\n    min-height: 60px;\n  }\n\n  .sm-hipaa-notice {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 11.5px;\n    color: #64748B;\n    margin: 8px 0 18px;\n    line-height: 1.35;\n  }\n  .sm-hipaa-notice svg {\n    color: #179A9E;\n    flex-shrink: 0;\n  }\n  .sm-modal-submit-btn {\n    width: 100%;\n    padding: 13px 20px;\n    background-color: #179A9E;\n    color: #FFFFFF;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n    box-shadow: 0 4px 12px rgba(23, 154, 158, 0.25);\n  }\n  .sm-modal-submit-btn:hover {\n    background-color: #102C40;\n    transform: translateY(-2px);\n  }\n  .sm-modal-success {\n    display: none;\n    text-align: center;\n    padding: 24px 8px;\n  }\n  .sm-modal-success-icon {\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background-color: #EAF8F8;\n    color: #179A9E;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 auto 16px;\n  }\n</style>\n\n<script>\n(function() {\n  function initCalculator() {\n    var billingsSlider = document.getElementById('sm-billings-range');\n    var billingsDisplay = document.getElementById('sm-billings-display');\n    var billingsFill = document.getElementById('sm-billings-fill');\n\n    var specialtySelect = document.getElementById('sm-specialty-select');\n\n    var providersSlider = document.getElementById('sm-providers-range');\n    var providersDisplay = document.getElementById('sm-providers-display');\n    var providersFill = document.getElementById('sm-providers-fill');\n\n    var annualRecapturedEl = document.getElementById('sm-annual-recaptured');\n    var metricArEl = document.getElementById('sm-metric-ar');\n    var metricCleanEl = document.getElementById('sm-metric-clean');\n\n    if (!billingsSlider || !specialtySelect || !providersSlider) return;\n\n    function formatCurrency(num) {\n      return '$' + Math.round(num).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n    }\n\n    function updateCalculator() {\n      var billings = parseFloat(billingsSlider.value) || 120000;\n      var providers = parseInt(providersSlider.value, 10) || 3;\n\n      // Update Slider Fills & Value Displays\n      billingsDisplay.textContent = formatCurrency(billings) + ' / mo';\n      var billingsPct = ((billings - 30000) / (1000000 - 30000)) * 100;\n      if (billingsFill) billingsFill.style.width = billingsPct + '%';\n\n      providersDisplay.textContent = providers + (providers === 1 ? ' Provider' : ' Providers');\n      var providersPct = ((providers - 1) / (25 - 1)) * 100;\n      if (providersFill) providersFill.style.width = providersPct + '%';\n\n      // Specialty Rate & Benchmarks\n      var selectedOpt = specialtySelect.options[specialtySelect.selectedIndex];\n      var baseRate = parseFloat(selectedOpt.getAttribute('data-rate')) || 0.180;\n      var arBefore = selectedOpt.getAttribute('data-ar-before') || '53';\n      var arAfter = selectedOpt.getAttribute('data-ar-after') || '26';\n      var cleanRate = selectedOpt.getAttribute('data-clean') || '98.5';\n\n      // Provider Scale adjustment (at 3 providers, multiplier is 1.0)\n      var providerScale = 1.0;\n      if (providers > 5 && providers <= 10) {\n        providerScale = 1.02;\n      } else if (providers > 10) {\n        providerScale = 1.04;\n      }\n\n      var annualBillings = billings * 12;\n      var annualRecaptured = annualBillings * baseRate * providerScale;\n\n      // Update Display Elements\n      if (annualRecapturedEl) {\n        annualRecapturedEl.textContent = formatCurrency(annualRecaptured);\n      }\n      if (metricArEl) {\n        metricArEl.innerHTML = '<span class=\"sm-metric-before\">' + arBefore + 'd</span> <span class=\"sm-metric-arrow\">→</span> <span class=\"sm-metric-after\">' + arAfter + ' days</span>';\n      }\n      if (metricCleanEl) {\n        metricCleanEl.textContent = cleanRate + '%';\n      }\n    }\n\n    billingsSlider.addEventListener('input', updateCalculator);\n    providersSlider.addEventListener('input', updateCalculator);\n    specialtySelect.addEventListener('change', updateCalculator);\n\n    updateCalculator();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initCalculator);\n  } else {\n    initCalculator();\n  }\n})();\n\n// Function triggered by \"Claim Your Detailed Practice Audit\" button\nwindow.smOpenAuditModalFromCalculator = function() {\n  var billingsSlider = document.getElementById('sm-billings-range');\n  var specialtySelect = document.getElementById('sm-specialty-select');\n  var providersSlider = document.getElementById('sm-providers-range');\n  var annualRecapturedEl = document.getElementById('sm-annual-recaptured');\n\n  var billingsVal = billingsSlider ? '$' + Number(billingsSlider.value).toLocaleString() + ' / mo' : '$120,000 / mo';\n  var specialtyText = specialtySelect ? specialtySelect.options[specialtySelect.selectedIndex].text : 'Internal Medicine / Primary Care';\n  var providersVal = providersSlider ? providersSlider.value + ' Providers' : '3 Providers';\n  var recapturedVal = annualRecapturedEl ? annualRecapturedEl.textContent : '$259,200';\n\n  var snapshotNote = 'Practice Audit Request: Est. Recaptured: ' + recapturedVal + '/yr (Billings: ' + billingsVal + ', Specialty: ' + specialtyText + ', ' + providersVal + ')';\n\n  // Open modal and prefill\n  window.smOpenAuditModal(snapshotNote);\n\n  // Sync modal specialty select if matching\n  var modalSpec = document.getElementById('sm-field-specialty');\n  if (modalSpec && specialtyText) {\n    for (var i = 0; i < modalSpec.options.length; i++) {\n      if (modalSpec.options[i].text.toLowerCase().indexOf(specialtyText.toLowerCase().split(' ')[0]) !== -1) {\n        modalSpec.selectedIndex = i;\n        break;\n      }\n    }\n  }\n\n  // Sync modal volume select\n  var modalVol = document.getElementById('sm-field-volume');\n  if (modalVol && billingsSlider) {\n    var rawNum = Number(billingsSlider.value);\n    if (rawNum < 50000) modalVol.value = 'Under $50,000 / mo';\n    else if (rawNum <= 100000) modalVol.value = '$50,000 - $100,000 / mo';\n    else if (rawNum <= 250000) modalVol.value = '$100,000 - $250,000 / mo';\n    else if (rawNum <= 500000) modalVol.value = '$250,000 - $500,000 / mo';\n    else modalVol.value = '$500,000+ / mo';\n  }\n};\n\n// Universal Modal Open (Teleport to document.body)\nwindow.smOpenAuditModal = function(prefill) {\n  var modal = document.getElementById('sm-audit-modal');\n  if (!modal) return;\n  if (modal.parentElement !== document.body) {\n    document.body.appendChild(modal);\n  }\n  var formView = document.getElementById('sm-modal-form-view');\n  var successView = document.getElementById('sm-modal-success-view');\n  if (formView) formView.style.display = 'block';\n  if (successView) successView.style.display = 'none';\n\n  if (prefill) {\n    var notes = document.getElementById('sm-field-notes');\n    if (notes) notes.value = prefill;\n  }\n  modal.style.setProperty('display', 'flex', 'important');\n  modal.style.display = 'flex';\n  document.body.style.overflow = 'hidden';\n};\n\n// Universal Modal Close (Closes all open modals unconditionally)\nwindow.smCloseAuditModal = function() {\n  var allModals = document.querySelectorAll('.sm-modal-backdrop');\n  for (var i = 0; i < allModals.length; i++) {\n    allModals[i].style.setProperty('display', 'none', 'important');\n    allModals[i].style.display = 'none';\n    allModals[i].classList.remove('is-active');\n  }\n  document.body.style.overflow = '';\n};\n\nwindow.smHandleAuditSubmit = function(e) {\n  e.preventDefault();\n  var btn = document.getElementById('sm-btn-submit');\n  if (btn) btn.innerHTML = '<span>Processing Audit Request...</span>';\n  setTimeout(function() {\n    var formView = document.getElementById('sm-modal-form-view');\n    var successView = document.getElementById('sm-modal-success-view');\n    if (formView) formView.style.display = 'none';\n    if (successView) successView.style.display = 'block';\n    if (btn) btn.innerHTML = '<span>Confirm Free Consultation &amp; Audit</span>';\n  }, 600);\n};\n\n// Close on Escape Key\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'Escape' || e.keyCode === 27) {\n    window.smCloseAuditModal();\n  }\n});\n\n// Capture-phase Global Click Listener\ndocument.addEventListener('click', function(e) {\n  var closeBtn = e.target.closest ? e.target.closest('.sm-modal-close-btn, [aria-label=\"Close modal\"]') : null;\n  if (closeBtn) {\n    e.preventDefault();\n    e.stopPropagation();\n    var b = closeBtn.closest ? closeBtn.closest('.sm-modal-backdrop') : null;\n    if (b) {\n      b.style.setProperty('display', 'none', 'important');\n      b.style.display = 'none';\n    }\n    window.smCloseAuditModal();\n    return;\n  }\n\n  var backdrop = e.target.closest ? e.target.closest('.sm-modal-backdrop') : null;\n  if (backdrop && e.target === backdrop) {\n    e.preventDefault();\n    e.stopPropagation();\n    backdrop.style.setProperty('display', 'none', 'important');\n    backdrop.style.display = 'none';\n    window.smCloseAuditModal();\n    return;\n  }\n}, true);\n</script>\n"
              }
            }
          ]
        }
