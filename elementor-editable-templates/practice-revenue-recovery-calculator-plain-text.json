              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Average US practices lose 15% to 25% of legitimate billings to unresolved claim denials, coding inaccuracies, and delayed payer follow-ups. See how much StelleMed can recapture.</p>",
                "align": "center",
